@page
@model EmployeeLeaveManagementSystem.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCOUNT SECURITY</p>
        <h1>Change Password</h1>
        <p class="muted">Update your password to keep your account secure.</p>
    </div>
</div>

<section class="panel narrow password-panel">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="field">
            <label asp-for="Input.CurrentPassword"></label>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword"></span>
        </div>

        <div class="field">
            <label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"></span>
        </div>

        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>

        <p class="muted password-hint">Use at least 8 characters, including an uppercase letter, a number, and a symbol.</p>
        <div class="form-actions">
            <button type="submit" class="button">Update password</button>
            <a asp-controller="Dashboard" asp-action="Index" class="button secondary">Cancel</a>
        </div>
    </form>
</section>
