<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - LeaveTrack</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="topbar"><a class="brand" asp-controller="Dashboard" asp-action="Index">LeaveTrack</a>
        <nav><a asp-controller="Dashboard" asp-action="Index">Dashboard</a><a asp-controller="LeaveRequests"
                                                                                  asp-action="Index">Leave requests</a>@if(User.IsInRole("Admin")){
            <a asp-controller="Employees"
               asp-action="Index">Employees</a>
        }
        @if (User.Identity?.IsAuthenticated == true &&
                    User.IsInRole("Employee"))
        {
            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Change
                password</a>
            }
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <main class="container">@if(TempData["Success"] is string success){
        <div class="alert success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert error">@error</div>
    }
    @RenderBody()</main>
    <footer>Employee Leave Management System · ASP.NET Core MVC</footer>@await RenderSectionAsync("Scripts", required:
        false)
</body>

</html>