@model Employee
@{
    ViewData["Title"] = "Edit employee";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">TEAM DIRECTORY</p>
        <h1>Edit employee</h1>
    </div>
</div>
<section class="panel narrow">
    <form asp-action="Edit" method="post"><input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="form-actions"><button class="button" type="submit">Save changes</button><a class="button secondary"
                                                                                                   asp-action="Index">Cancel</a></div>
        </form>
    </section>